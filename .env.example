# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, only if image_provider: pexels
PEXELS_API_KEY=

# Optional free token for FLUX images: https://huggingface.co/settings/tokens (visuals.image_provider: huggingface)
